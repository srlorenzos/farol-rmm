# Variáveis do site do Farol RMM (Vercel: `vercel env add NOME production`). Nunca commite o arquivo .env.

# Stripe (sem esta chave os botões de compra viram "Fale com vendas")
STRIPE_SECRET_KEY=sk_live_...
# Segredo do endpoint de webhook (Stripe -> Developers -> Webhooks -> https://SEU-SITE/api/webhook)
STRIPE_WEBHOOK_SECRET=whsec_...

# Chave PRIVADA Ed25519 (PEM PKCS8) que assina as licenças. Pode usar \n literais no lugar das quebras de linha.
# A pública correspondente já está embutida no servidor (servidor/src/modulos/licenca/chave.js).
LICENCA_CHAVE_PRIVADA="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# Vercel Blob (store privado): guarda licenças emitidas (farol/licencas/) e contatos (farol/contatos/)
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...

# Opcionais
# URL pública do site (usada nos redirecionamentos do Stripe). Padrão: o host da requisição.
SITE_URL=https://farol-rmm.vercel.app
# E-mail de contato usado no fallback "mailto" do formulário
CONTATO_EMAIL=lorenzoprofissional@gmail.com

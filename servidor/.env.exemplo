# Copie para servidor/.env e ajuste.
# Porta e interface de escuta. Mantenha 127.0.0.1 e exponha via proxy reverso com HTTPS.
PORT=8420
HOST=127.0.0.1
# Caminho do banco SQLite (relativo à pasta servidor/).
DB=dados/farol.db
# URL pública (com https://) — usada nos comandos de instalação e para ligar cookie Secure + HSTS.
URL_PUBLICA=https://farol.exemplo.com.br
# Webhook padrão para alertas (pode ser alterado no painel). Opcional.
WEBHOOK_URL=
# Duração da sessão do painel, em horas.
SESSAO_HORAS=12
# 1 = confiar no X-Forwarded-For do proxy reverso (já ligado quando URL_PUBLICA é https).
TRUST_PROXY=0
